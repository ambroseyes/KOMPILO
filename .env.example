# ──────────────────────────────────────────────────────────────
# Kompilo — environment variables
# Copy to .env and fill REAL values.  NEVER commit .env.
# ──────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────
APP_NAME=Kompilo
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO

# ── Security ──────────────────────────────────────────────────
# Generate with:  python3 -c "import secrets; print('JWT_SECRET=' + secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_generate_a_long_random_value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS: comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# ── LLM providers (optional — leave blank until real pipeline stages call out) ──
# NEVER commit real keys. Kompilo targets Claude (Anthropic).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── PostgreSQL — superuser / admin (used by Alembic migrations) ──
POSTGRES_USER=kompilo
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=kompilo

# ── PostgreSQL — application role (least privilege, RLS-enforced) ──
APP_DB_USER=kompilo_app
APP_DB_PASSWORD=CHANGE_ME_another_password

# Runtime connection (app role — RLS enforced). Used by FastAPI & worker.
DATABASE_URL=postgresql+asyncpg://kompilo_app:CHANGE_ME_another_password@postgres:5432/kompilo

# Admin connection (superuser) — used by Alembic migrations ONLY.
ALEMBIC_DATABASE_URL=postgresql+asyncpg://kompilo:CHANGE_ME_strong_db_password@postgres:5432/kompilo

# ── Redis / ARQ ───────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Frontend (Vite) ───────────────────────────────────────────
# Must be reachable from the browser (the host machine), hence localhost.
VITE_API_URL=http://localhost:8000
