# ──────────────────────────────────────────────────────────────
# Kompilo — environment variables
# Copy to .env and fill REAL values.  NEVER commit .env.
# ──────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────
APP_NAME=Kompilo
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO

# ── Security ──────────────────────────────────────────────────
# Generate with:  python3 -c "import secrets; print('JWT_SECRET=' + secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_generate_a_long_random_value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS: comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# ── LLM providers (optional — leave blank to stay fully offline/free) ──
# NEVER commit real keys. The SAME OPENAI_API_KEY drives two things:
#   • the Intent Engine's LLM fallback — called ONLY when heuristic confidence is low;
#   • real plan EXECUTION via /v1/execute — when the key is absent, execution falls back
#     to a deterministic OFFLINE Echo STUB (clearly flagged provider_is_real=false).
# Works with OpenAI, Ollama or LM Studio (OpenAI-compatible) via OPENAI_BASE_URL.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: point at any OpenAI-compatible endpoint / pick a light model / tune the
# confidence threshold below which the LLM is consulted (0..1).
OPENAI_BASE_URL=https://api.openai.com/v1
INTENT_LLM_MODEL=gpt-4o-mini
INTENT_CONFIDENCE_THRESHOLD=0.6

# ── Gateway / execution (single exit point for model calls) ───
# Default model used when the router picks none; semantic-cache TTL (0 disables the
# cache); retries per model before falling back; exponential backoff base (seconds).
EXECUTION_LLM_MODEL=gpt-4o-mini
GATEWAY_CACHE_TTL_SECONDS=3600
GATEWAY_MAX_ATTEMPTS_PER_MODEL=2
GATEWAY_BACKOFF_BASE_SECONDS=0.2

# ── PostgreSQL — superuser / admin (used by Alembic migrations) ──
POSTGRES_USER=kompilo
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=kompilo

# ── PostgreSQL — application role (least privilege, RLS-enforced) ──
APP_DB_USER=kompilo_app
APP_DB_PASSWORD=CHANGE_ME_another_password

# Runtime connection (app role — RLS enforced). Used by FastAPI & worker.
DATABASE_URL=postgresql+asyncpg://kompilo_app:CHANGE_ME_another_password@postgres:5432/kompilo

# Admin connection (superuser) — used by Alembic migrations ONLY.
ALEMBIC_DATABASE_URL=postgresql+asyncpg://kompilo:CHANGE_ME_strong_db_password@postgres:5432/kompilo

# ── Redis / ARQ ───────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Frontend (Vite) ───────────────────────────────────────────
# Must be reachable from the browser (the host machine), hence localhost.
VITE_API_URL=http://localhost:8000
